{
  "functions": {
    "api/[...path].js": {
      "maxDuration": 10,
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/analytics/:id", "destination": "/index.html" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/:shortCode", "destination": "/api/go/:shortCode" }
  ]
}
