{
  "functions": {
    "api/[...path].js": {
      "maxDuration": 10,
      "includeFiles": "backend/**"
    },
    "api/go/[code].js": {
      "maxDuration": 10,
      "includeFiles": "backend/**"
    },
    "api/resolve/[code].js": {
      "maxDuration": 10,
      "includeFiles": "backend/**"
    },
    "api/urls/[id].js": {
      "maxDuration": 10,
      "includeFiles": "backend/**"
    },
    "api/urls/[id]/analytics.js": {
      "maxDuration": 10,
      "includeFiles": "backend/**"
    },
    "api/urls/[id]/qr.js": {
      "maxDuration": 10,
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/analytics/:id", "destination": "/index.html" },
    { "source": "/:code", "destination": "/api/go/:code" }
  ]
}
